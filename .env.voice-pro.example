# Copy to .env for Docker Compose, or load with uv run --env-file .env.
# Set a real key before starting the Voice-Pro profile.
VIENEU_VOICE_PRO_ENABLED=1
VIENEU_API_KEY=replace_with_your_key
# Speech model: API v1 supports v3turbo only.
VIENEU_BACKBONE=v3turbo
# Optional local checkpoint profile: exact backbone_configs key from config.yaml.
# Leave empty to use the official model. See docs/backbones.vi.md for all choices.
VIENEU_MODEL_PROFILE=
# VIENEU_CONFIG_PATH defaults to the project's config.yaml (local Python server).
# Example: VIENEU_MODEL_PROFILE="VieNeu-TTS-v3-Turbo — Đạt Phi 01 (GPU)"
# Inference runtime, separate from the speech model: auto, onnx, or pytorch.
VIENEU_BACKEND=auto
VIENEU_DEVICE=auto
VIENEU_TTS_TIMEOUT=300
VIENEU_MAX_TEXT_CHARS=20000
VIENEU_MAX_REQUEST_BYTES=262144
VIENEU_MAX_AUDIO_SECONDS=600
VIENEU_MAX_OUTPUT_BYTES=67108864
VIENEU_ENCODING_WORKERS=2
# Optional: VIENEU_MAX_COMPLETE_REQUESTS defaults to effective max_streams.
# Optional: VIENEU_FFMPEG_PATH is the executable name/path, without shell quotes.
# Optional: VIENEU_HOME sets the data directory outside Docker.
